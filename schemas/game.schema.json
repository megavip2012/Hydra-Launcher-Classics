{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megavip2012.github.io/Hydra-Launcher-Classics/schemas/game.schema.json",
  "title": "VimmVault game catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "platform",
    "vimmUrl",
    "linkStatus",
    "download"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "releaseYear": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1970,
      "maximum": 2100
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "developer": {
      "type": [
        "string",
        "null"
      ]
    },
    "cover": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "vimmUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://vimm\\\\.net/vault/[0-9]+$"
    },
    "linkStatus": {
      "const": "verified"
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogued",
        "downloadAvailable",
        "authorizedDownload"
      ],
      "properties": {
        "catalogued": {
          "const": true
        },
        "downloadAvailable": {
          "type": "boolean"
        },
        "authorizedDownload": {
          "type": "boolean"
        }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "uris"
      ],
      "properties": {
        "authorized": {
          "type": "boolean"
        },
        "uris": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authorized": {
                "const": false
              }
            },
            "required": [
              "authorized"
            ]
          },
          "then": {
            "properties": {
              "uris": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
